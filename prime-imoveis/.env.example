# URL pública do site (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.primeimoveis.com.br

# Quando o backend FastAPI existir, aponte para ele e troque USE_MOCKS para "false".
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=true

# NUNCA coloque chaves de IA ou segredos com prefixo NEXT_PUBLIC_.
# A integração com o assistente virtual deve ser feita pelo backend.
